# Copie ce fichier en .env puis mets ta clé.
# Clé Gemini gratuite : https://aistudio.google.com/apikey

PROVIDER=gemini
GEMINI_API_KEY=colle_ta_cle_ici

# Optionnel : changer de modèle
# MODEL=gemini-3.8-flash

# Autres fournisseurs possibles (même code, rien d'autre à changer) :
# PROVIDER=groq      GROQ_API_KEY=...     MODEL=...
# PROVIDER=ollama    MODEL=...            (modèle local, sans clé)
# PROVIDER=openai    OPENAI_API_KEY=...   MODEL=...
