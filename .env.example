# Copie ce fichier en .env puis mets ta clé.

# Option 1 : Claude (Anthropic), utilisé pendant la démo
# Clé : https://console.anthropic.com (crédits payants)
PROVIDER=claude
ANTHROPIC_API_KEY=colle_ta_cle_ici
# MODEL=claude-sonnet-5-5

# Option 2 : Gemini, gratuit avec une clé Google AI Studio
# Clé : https://aistudio.google.com/apikey
# PROVIDER=gemini
# GEMINI_API_KEY=colle_ta_cle_ici
# MODEL=gemini-3.8-flash

# Autres fournisseurs possibles (même code, rien d'autre à changer) :
# PROVIDER=groq      GROQ_API_KEY=...     MODEL=...
# PROVIDER=ollama    MODEL=...            (modèle local, sans clé)
# PROVIDER=openai    OPENAI_API_KEY=...   MODEL=...
